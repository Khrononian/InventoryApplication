<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <main>
        <header>
            <h1><%= title %></h1>
        </header>
        <%- include('partials/nav') %>
        <section>
            <ul>
                <% console.log(filteredGames, specificGameData, specificGameData[0], specificGameData[0][filteredGames[0].appid].data.header_image, 'BEGIN', Object.values(specificGameData[0])[0], 'BETWEEN', Object.values(specificGameData[0])[0].data.header_image, Object.values(specificGameData[0])[0].success ); %>
                <% dbGames.forEach(game => { %>
                    
                    
                    <div>
                        <li><% for (let i = 0; i < dbGames.length; i++) { %>
                            <% 
                            const gameWrapper = specificGameData && specificGameData[i];
                            const gameData = gameWrapper ? Object.values(gameWrapper)[0] : null;
                            %>
                            <% if (gameData) { %>
                            <% if (gameData.success && gameData.data && gameData.data.name == game.title) { %>
                                <img src="<%= gameData.data.header_image %>" alt="<%= gameData.name %>">
                            <% } else if (gameData.success === false && gameData.name == game.title) { %>
                                <p>Image not available</p>
                            <% } %>
                            <% } %>
                        
                        <% } %></li>
                        <li><%= game.title %> - <%= game.genre %></li>
                        <a href='/details'>Details</a>
                    </div>
                <% }) %>
            </ul>
        </section>
    </main>
</body>
</html>