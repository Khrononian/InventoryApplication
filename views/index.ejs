<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <main>
        <header>
            <h1><%= title %></h1>
        </header>
        <%- include('partials/nav') %>
        <section>
            <ul>
                <% dbGames.forEach(game => { %>
                    <div>
                        <li><% for (let i = 0; i < dbGames.length; i++) { %>
                            <% if ( dbGames[i].title == game.title) { %>
                                <img src="<%= game.game_img.url %>" alt="<%= game.title %>">
                            <% } %>
                        
                        <% } %></li>
                        <li><%= game.title %> - <%= game.genre %></li>
                        <a href="/details/<%= game.title %>">Details</a>
                        <form action='/delete' method="post">
                            <button type='submit' name='delete' value='<%= game.title %>'>Delete</button>
                        </form>
                    </div>
                <% }) %>
            </ul>
        </section>
    </main>
</body>
</html>