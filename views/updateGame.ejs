<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games Inventory</title>
    <link rel="stylesheet" href="/gameForm.css">
</head>
<body>
    <main>
        <nav>
            <%- include('partials/nav') %>
        </nav>
        <h1><%= title %></h1>
        
        <% if (locals.error) { %>
            <div class="error">
                <h2>Failed to update game</h2>
                <p><%= error %></p>
                <p>Try again!</p>
            </div>
        <% } %>

        <form action='/update/<%= gameTitle %>' method='POST'>
            <label for='title'>Title <span>*</span></label>
            <input type='text' name='title' id='title' value="<%= gameData.rows[0].title %>" required>

            <label for='genre'>Genre <span>*</span></label>
            <select name='genre' id='genre' required>
                <% categories.forEach(category => { %>
                    <option value="<%= category.name %>" <%= category.name === gameData.rows[0].genre ? 'selected' : '' %>>
                        <%= category.name %>
                    </option>
                <% }) %>
            </select>

            <label for='developer'>Developer <span>*</span></label>
            <input type='text' name='developer' id='developer' value="<%= gameData.rows[0].developer %>" required>
            <label for='release_date'>Release Date <span>*</span></label>
            <input type='date' name='release_date' id='release_date' value="<%= formattedDate %>" required>
            
            <label for='description'>Description <span>*</span></label>
            <textarea name='description' id='description'  required><%= gameData.rows[0].description %></textarea>

            <button type='submit'>Update Game</button>
        </form>
    </main>
</body>
</html>