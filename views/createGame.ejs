<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games Inventory</title>
    <link rel="stylesheet" href="/gameForm.css">
</head>
<body>
    <main>
        <nav>
        <%- include('partials/nav') %>
        </nav>

        <h1>Create Game based on Steam!</h1>

        <% if (locals.error) { %>
            <div>
                <p style="color: red;"><%= error %></p>
            </div>
        <% } %>

        <form action='/create' method='POST'>
            <label for='title'>Title <span>*</span></label>
            <input placeholder="Enter Steam Game" type='text' name='title' id='title' value="<%= formData ? formData.title : '' %>" required>
            <label for='genre'>Genre <span>*</span></label>
            <select name='genre' id='genre' required>
                <option value='Action' <%= formData && formData.genre === 'Action' ? 'selected' : '' %>>Action</option>
                <option value='Adventure' <%= formData && formData.genre === 'Adventure' ? 'selected' : '' %>>Adventure</option>
                <option value='Survival' <%= formData && formData.genre === 'Survival' ? 'selected' : '' %>>Survival</option>
                <option value='Simulation' <%= formData && formData.genre === 'Simulation' ? 'selected' : '' %>>Simulation</option>
                <option value='Platformer' <%= formData && formData.genre === 'Platformer' ? 'selected' : '' %>>Platformer</option>
                <option value='Shooter' <%= formData && formData.genre === 'Shooter' ? 'selected' : '' %>>Shooter</option>
                <option value='Metroidvania' <%= formData && formData.genre === 'Metroidvania' ? 'selected' : '' %>>Metroidvania</option>
            </select>

            <label for='developer'>Developer <span>*</span></label>
            <input placeholder="Enter Developer" type='text' name='developer' id='developer' value="<%= formData ? formData.developer : '' %>" required>
            <label for='release_date'>Release Date <span>*</span></label>
            <input placeholder="Enter Release Date" type='date' name='release_date' id='release_date' value="<%= formData ? formData.release_date : '' %>" required>

            <label for='description'>Description <span>*</span></label>
            <textarea placeholder="Enter Description" name='description' id='description' required><%= formData ? formData.description : '' %></textarea>

            <button type='submit'>Create Game</button>
        </form>
    </main>
</body>
</html>