<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games Inventory</title>
    <link rel="stylesheet" href="/details.css">
</head>
<body>
    <main>
        <nav>
            <%- include('partials/nav') %>
        </nav>
        <header>
            <h1><%= gameTitle %></h1>
            <button class="update-btn"><a href="/update/<%= gameTitle %>">Update</a></button>
            <% if (isOriginalGame) { %>
                <form>
                    <button type='submit' name='delete' value='<%= gameTitle %>'><a href="/delete/<%= gameTitle %>">Delete</a></button>
                </form>
            <% } else { %>
                <form action="/delete" method="post">
                    <button type='submit' name='delete' value='<%= gameTitle %>'>Delete</button>
                </form>
            <% } %>
        </header>
        <div>
            <ul>
                <% if (gameDetails) { %>
                    <li><img src="<%= imageUrl %>" alt="<%= gameDetails.title %>"></li>
                    <div class="game-details">
                        <li><%= gameDetails.release_date.toDateString() %>,</li>
                        <li><%= gameDetails.genre %>,</li>
                        <li><%= gameDetails.developer %></li>
                    </div>
                    <div class="game-description">
                        <li>Description<br> <%= gameDetails.description %></li>
                    </div>
                <% } %>
            </ul>
        </div>
        <% if (locals.approvalError) { %>
            <div class="admin">
                <h3>Admin Authorization</h3>
                <form class="admin-form">
                    <p>Enter the admin password to update <%= gameTitle %></p>
                    <label for="adminPass">Admin Password <span>*</span></label>
                    <input placeholder="Enter admin password" type="password" id="adminPass" name="adminPass">
                    <button type="submit">Submit</button>
                    <% if (locals.pinError) { %>
                        <p class="error"><%= locals.pinError %></p>
                    <% } %>
                </form>
            </div>
        <% } %>
        
    </main>
</body>
</html>