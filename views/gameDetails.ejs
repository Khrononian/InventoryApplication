<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Games Inventory</title>
</head>
<body>
    <main>
        <nav>
            <%- include('partials/nav') %>
        </nav>
        <h1><%= gameTitle %></h1>
        <button><a href="/update:gameTitle">Update</a></button>
        <div>
            <ul>
                <% console.log('gameDetails:', gameDetails); %>
                <% if (gameDetails) { %>
                    <li><img src="<%= imageUrl %>" alt="<%= gameDetails.title %>"></li>
                    <li>Genre: <%= gameDetails.genre %></li>
                    <li>Developer: <%= gameDetails.developer %></li>
                    <li>Release Date: <%= gameDetails.release_date.toDateString() %></li>
                    <li>Description<br> <%= gameDetails.description %></li>
                <% } else { %>
                    <p>Game not found.</p>
                <% } %>
            </ul>
        </div>
    </main>
    
</body>
</html>