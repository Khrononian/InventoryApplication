<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <nav>
        <div>
            <a href="/">Home</a>
            <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <button><a href="/category/<%= category.name.toLowerCase() %>"><%= category.name %></a></button>
            <% }) %>
            <% } %>
            <a href="/create">Create Game</a>
        </div>
    </nav>
</body>
</html>